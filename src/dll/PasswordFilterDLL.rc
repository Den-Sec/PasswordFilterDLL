#include <windows.h>

// Version information for the DLL. The Event Log message table, when built with mc.exe,
// is linked in separately (see src/dll/CMakeLists.txt).

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0, 1, 0, 0
 PRODUCTVERSION 0, 1, 0, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Den-Sec (Dennis Sepede)"
            VALUE "FileDescription", "LSA password filter for Active Directory"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "PasswordFilterDLL"
            VALUE "LegalCopyright", "Copyright (C) 2026 Dennis Sepede. MIT License."
            VALUE "OriginalFilename", "PasswordFilterDLL.dll"
            VALUE "ProductName", "PasswordFilterDLL"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
