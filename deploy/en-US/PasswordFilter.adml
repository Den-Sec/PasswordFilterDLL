<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0"
    xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>PasswordFilterDLL</displayName>
  <description>Group Policy template for the Den-Sec LSA password filter.</description>
  <resources>
    <stringTable>
      <string id="Cat_PasswordFilter">Den-Sec Password Filter</string>

      <string id="MinLength">Minimum password length</string>
      <string id="MinLength_Help">Reject passwords shorter than this many characters. Default: 12.</string>
      <string id="MaxLength">Maximum password length</string>
      <string id="MaxLength_Help">Reject passwords longer than this many characters. Default: 256.</string>
      <string id="RequiredClasses">Required character classes</string>
      <string id="RequiredClasses_Help">Minimum number of character classes (lowercase, uppercase, digit, symbol) a password must contain, 0-4. Set 0 to disable. Default: 3.</string>
      <string id="MaxRepeatRun">Maximum repeated-character run</string>
      <string id="MaxRepeatRun_Help">Reject passwords with a run of identical characters longer than this (e.g. "aaaaa"). Set 0 to disable. Default: 4.</string>

      <string id="RejectKeyboardPatterns">Reject keyboard walks (qwerty, asdf)</string>
      <string id="RejectKeyboardPatterns_Help">Reject passwords containing horizontal keyboard walks. Default: Enabled.</string>
      <string id="RejectSequences">Reject sequences (abcd, 1234)</string>
      <string id="RejectSequences_Help">Reject passwords containing ascending or descending character sequences. Default: Enabled.</string>
      <string id="RejectContainsAccountName">Reject passwords containing the account name</string>
      <string id="RejectContainsAccountName_Help">Reject passwords that contain the user's sAMAccountName. Default: Enabled.</string>
      <string id="RejectContainsFullName">Reject passwords containing the full name</string>
      <string id="RejectContainsFullName_Help">Reject passwords that contain a token of the user's display name. Default: Enabled.</string>
      <string id="CheckBreach">Check against the offline breach list</string>
      <string id="CheckBreach_Help">Reject passwords found in the offline HIBP breach Bloom filter. Default: Enabled. Requires breach.bloom in the data directory.</string>
      <string id="FailOpenOnError">Fail open on internal error</string>
      <string id="FailOpenOnError_Help">When the filter hits an internal error, allow the change (recommended, avoids lockouts) rather than blocking it. Default: Enabled.</string>

      <string id="DataDir">Data directory</string>
      <string id="DataDir_Help">Folder holding breach.bloom, blacklist.txt and company_terms.txt. Default: %ProgramData%\PasswordFilter.</string>
    </stringTable>
    <presentationTable>
      <presentation id="MinLength">
        <decimalTextBox refId="MinLength_Val" defaultValue="12">Minimum length:</decimalTextBox>
      </presentation>
      <presentation id="MaxLength">
        <decimalTextBox refId="MaxLength_Val" defaultValue="256">Maximum length:</decimalTextBox>
      </presentation>
      <presentation id="RequiredClasses">
        <decimalTextBox refId="RequiredClasses_Val" defaultValue="3">Required classes (0-4):</decimalTextBox>
      </presentation>
      <presentation id="MaxRepeatRun">
        <decimalTextBox refId="MaxRepeatRun_Val" defaultValue="4">Max repeated run:</decimalTextBox>
      </presentation>
      <presentation id="DataDir">
        <textBox refId="DataDir_Val">
          <label>Data directory:</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
